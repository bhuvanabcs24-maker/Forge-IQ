# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Active Payment Provider (razorpay | stripe | mock)
NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ForgeIQ Python AI Microservice
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
AI_SERVICE_API_KEY=forgeiq_internal_service_key_2026

# OTP.dev SMS Verification API
OTP_DEV_API_KEY=your_otp_dev_api_key
OTP_DEV_SENDER=your_otp_dev_sender_uuid
OTP_DEV_TEMPLATE=your_otp_dev_template_uuid
OTP_DEV_CODE_LENGTH=4

# Neon PostgreSQL Database
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
POSTGRES_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
POSTGRES_PRISMA_URL=postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
POSTGRES_USER=your_db_user
POSTGRES_HOST=your_endpoint.neon.tech
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=neondb
PGSSLMODE=require

