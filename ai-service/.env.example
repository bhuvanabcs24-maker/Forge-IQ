# AI Provider Configuration (openai | gemini | anthropic | ollama | mock)
AI_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ForgeIQ Service-to-Service Security
AI_SERVICE_API_KEY=forgeiq_internal_service_key_2026
JWT_SECRET=forgeiq_jwt_secret_change_in_production

# Vector Database (PostgreSQL / Supabase pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/forgeiq
VECTOR_DIMENSION=768
VECTOR_BACKEND=memory  # options: pgvector | memory

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
